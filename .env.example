# Neon pooled connection string kept server-side. Use the hostname containing
# `-pooler` for the deployed application and normal local runtime queries.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Direct (non-pooler) Neon connection used by migrations and other operator
# commands. Never expose either database URL to the browser.
DATABASE_MIGRATION_URL=
# The Vercel-managed Neon integration calls the same value
# DATABASE_URL_UNPOOLED. Migration tooling accepts either name.
DATABASE_URL_UNPOOLED=

# Enable Neon Auth in the Neon Console and copy the generated endpoint.
NEON_AUTH_BASE_URL=https://your-auth-endpoint.neon.tech
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
# Data API endpoint ending in /rest/v1. Authenticated mutations forward the
# Neon Auth JWT here so PostgreSQL RLS can verify the actor.
NEON_DATA_API_URL=https://your-data-api-endpoint.neon.tech/rest/v1

# Local-only development session. This is rejected when NODE_ENV=production.
DEV_AUTH_BYPASS=false
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_USER_EMAIL=owner@example.com
DEV_USER_NAME=Local Owner

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backup job configuration (GitHub Actions secrets in production).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=edh-pod-tracker-backups
BACKUP_ENCRYPTION_PASSPHRASE=
